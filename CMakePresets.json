{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "environment": { "CXX": "$env{CNOTE_CXX}" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{CNOTE_QT}"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Development: shared libraries, ccache",
      "binaryDir": "${sourceDir}/build-dev",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release: static, as CI and packages",
      "binaryDir": "${sourceDir}/build-release"
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "environment": { "CCACHE_BASEDIR": "${sourceDir}" }
    },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
